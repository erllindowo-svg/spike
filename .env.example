# Copie para .env.local e preencha. Nunca versione arquivos .env com valores reais.
# Obrigatórias para abrir o app: MONGODB_URI e JUDIT_API_KEY (sem elas, a tela diz o que falta).
# Variáveis usadas apenas no servidor: não use o prefixo NEXT_PUBLIC_.
# Os nomes e formatos são validados em src/lib/env.ts.

# String de conexão do MongoDB (o Atlas fornece o formato mongodb+srv://).
# A senha é a do usuário do banco (Atlas > Database Access), não a do login no Atlas.
# Exemplo fictício: mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/
MONGODB_URI=

# Nome do banco dentro do cluster (não é o nome do cluster). Padrão: raio_x.
MONGODB_DB=

# Chave de API da JUDIT.
JUDIT_API_KEY=

# Chamadas reais à JUDIT só acontecem com o valor exato "enabled".
# Vazio ou ausente significa desligado.
JUDIT_LIVE_CALLS=

# Modo restrito: buscas por documento ou CNJ só para a lista de teste em src/lib/judit/guard.ts.
# Vazio: ligado, e o interruptor em Configurações (modo desenvolvedor) pode desligar.
# "disabled": começa desligado. "locked": sempre ligado, sem interruptor (para publicar o app).
JUDIT_ALLOWLIST=

# Limite nosso de chamadas à JUDIT por minuto (1 a 170; a JUDIT aceita 180). Vazio: 30.
JUDIT_MAX_CALLS_PER_MINUTE=

# Teto diário de chamadas cobradas, contado no histórico do app. Vazio: 50.
JUDIT_DAILY_CALL_LIMIT=

# Segredo do webhook da JUDIT (mínimo de 32 caracteres), enviado na callback_url como ?token=.
# Gere com: openssl rand -hex 32. Vazio ou ausente: a rota /api/webhooks/judit fica desligada (404).
JUDIT_WEBHOOK_TOKEN=

# Modo manutenção: "enabled" grava o payload inteiro de cada webhook, com os dados do processo.
# Use só para diagnóstico. Vazio ou ausente: grava o envelope e um resumo da resposta.
JUDIT_WEBHOOK_FULL_PAYLOAD=

# Origem pública https onde a JUDIT alcança este app (em desenvolvimento, a URL do túnel, que muda
# a cada execução). Preenchida: as consultas assíncronas do app enviam callback_url e recebem o
# resultado por webhook. Vazia ou ausente: só polling ("Verificar status").
JUDIT_WEBHOOK_PUBLIC_ORIGIN=
