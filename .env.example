# Copie para .env.local e preencha. Nunca versione arquivos .env com valores reais.
# Variáveis usadas apenas no servidor: não use o prefixo NEXT_PUBLIC_.

# String de conexão PostgreSQL (Neon, Supabase ou qualquer Postgres gerenciado).
# Exemplo fictício: postgresql://usuario:senha@host.exemplo:5432/raio_x?sslmode=require
DATABASE_URL=

# Chave de API da JUDIT.
JUDIT_API_KEY=
